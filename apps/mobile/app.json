{
  "expo": {
    "name": "Brew & Move",
    "slug": "brew-n-move",
    "scheme": "brew-n-move",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brewandmove.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.brewandmove.app",
      "permissions": [
        "android.permission.health.READ_STEPS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5ea6e594-7a68-4199-b9e1-05677c22e7d6"
      }
    },
    "owner": "dmsierra11",
    "plugins": [
      "expo-font",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Brew & Move reads today’s step count from Apple Health so you can see your progress toward Brew Points.",
          "NSHealthUpdateUsageDescription": "Brew & Move does not write health data. This permission is unused.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "manifestQueries": {
              "package": [
                "com.google.android.apps.healthdata"
              ]
            },
            "minSdkVersion": 26
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Brew & Move uses your location to confirm you are at the café before you redeem."
        }
      ]
    ]
  }
}
